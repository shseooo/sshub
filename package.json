{
  "name": "sshub",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app": "node scripts/dev.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "electron:build": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --out-extension:.js=.cjs --outdir=electron/out --external:electron --external:node-pty",
    "electron": "bun run electron:build && electron electron/out/main.cjs",
    "dist": "bun run build && bun run electron:build && electron-builder --mac"
  },
  "main": "electron/out/main.cjs",
  "build": {
    "appId": "com.shseooo.sshub",
    "productName": "sshub",
    "directories": {
      "output": "release"
    },
    "files": ["dist/**/*", "electron/out/**/*", "package.json"],
    "asarUnpack": ["**/node_modules/node-pty/**"],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jsdom": "^26",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^3"
  }
}
